{
  "name": "pathline",
  "productName": "Pathline",
  "version": "1.2.4",
  "description": "Pathline: prepare laser and plotter jobs — import, set speeds and feeds, simulate, and send to the machine controller.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "emulator": "node tools/device-emulator.js",
    "test": "node tools/selftest.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@xmldom/xmldom": "0.9.8",
    "clipper-lib": "6.4.2",
    "dxf-parser": "1.1.2",
    "electron-updater": "6.6.2",
    "opentype.js": "1.3.4",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.pathline.app",
    "productName": "Pathline",
    "publish": [
      {
        "provider": "github",
        "owner": "AESGlobalEngineering",
        "repo": "Pathline",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/ui/__preview*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "fileAssociations": [
      {
        "ext": "cjob",
        "name": "Pathline job",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pathline",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Pathline-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Pathline-${version}-portable.exe"
    }
  }
}
